{
  "name": "open-scripture",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "build": "pnpm --filter @scripture/web build && tsx scripts/offline-assets.ts",
    "preview": "tsx apps/api/src/server.ts --preview",
    "start": "tsx apps/api/src/server.ts --production",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "ingest": "tsx packages/ingest/src/cli.ts",
    "data:check": "tsx scripts/data-check.ts",
    "index:embeddings": "tsx scripts/index-embeddings.ts",
    "eval": "tsx scripts/evaluate.ts",
    "test:e2e": "playwright test",
    "test:models": "playwright test --config playwright.models.config.ts",
    "check:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm eval && pnpm data:check && pnpm test:e2e"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "description": "",
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "latest",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "fastify": "5.12.7",
    "kysely": "^0.28.8",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.0"
  }
}
